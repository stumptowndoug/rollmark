{
  "name": "@stumptowndoug/rollmark",
  "version": "0.1.3",
  "description": "Markdown-based document format and renderer for AI-generated reports with charts: a tiny LLM-friendly chart DSL, strict validation, and an opinionated SVG renderer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stumptowndoug/rollmark.git"
  },
  "homepage": "https://github.com/stumptowndoug/rollmark#readme",
  "bugs": {
    "url": "https://github.com/stumptowndoug/rollmark/issues"
  },
  "keywords": [
    "markdown",
    "markdown-it",
    "charts",
    "svg",
    "llm",
    "ai",
    "reports",
    "visualization",
    "d3"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/chart.v1.json": "./schemas/chart.v1.json",
    "./prompt-kit/system-prompt.md": "./prompt-kit/system-prompt.md",
    "./prompt-kit/examples.md": "./prompt-kit/examples.md"
  },
  "files": [
    "dist",
    "schemas",
    "prompt-kit",
    "SPEC.md",
    "docs/chart-dsl.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts",
    "build:images": "tsx scripts/readme-images.ts",
    "playground": "npm --prefix playground run dev",
    "viewer": "npm --prefix playground run dev -- --open /results.html"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-time-format": "^4.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "happy-dom": "^20.11.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "yaml": "^2.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
